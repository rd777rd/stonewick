# Copy this file to .env for local development.
# In production (Render), set these as real environment variables instead —
# never commit a real .env file.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite automatically. In production, Render
# provides this automatically when you attach a Postgres database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

SITE_DOMAIN=localhost:8000
SITE_PROTOCOL=http

# Email (defaults to console backend if unset — emails print to your terminal)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-smtp-key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Stonewick <hello@stonewick.com>

# Stripe (use your TEST mode keys locally, LIVE keys only in production)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
